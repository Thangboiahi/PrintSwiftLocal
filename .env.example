# GEMINI_API_KEY: Optional server-side key for future AI capabilities.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google Maps Platform Configuration
# Browser Maps JavaScript API key (restrict by HTTP referrer and allowed APIs in Google Cloud Console)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"
GOOGLE_MAPS_PLATFORM_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# Google Maps Map ID (required for Advanced Markers & Cloud-based Map Styling; defaults to DEMO_MAP_ID if unset)
# Associate both "PrintSwift Neutral Discovery" (Light) and "PrintSwift Midnight Discovery" (Dark) with this Map ID,
# or optionally provide separate Light and Dark Map IDs below.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID="DEMO_MAP_ID"
NEXT_PUBLIC_GOOGLE_MAPS_LIGHT_MAP_ID=""
NEXT_PUBLIC_GOOGLE_MAPS_DARK_MAP_ID=""
